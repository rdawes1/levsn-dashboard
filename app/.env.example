# Airtable Personal Access Token.
# Used ONLY by `npm run snapshot` (locally or in CI). Never shipped to the browser,
# and never needed on the hosting platform.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxx
AIRTABLE_BASE_ID=appVBC2SUwFcom2p5

# Mapbox public access token (pk.*) - safe to ship to the browser; restrict by URL in your Mapbox account
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: override the basemap style
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
